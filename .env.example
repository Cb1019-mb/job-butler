# 求职管家环境变量示例:复制为 .env 后按需修改。
# 说明:环境变量仅影响首次运行的默认值;settings 表已持久化的值优先,
#       改 env 不生效时在设置页修改,或 POST /api/settings/reset 重置。

# SQLite 数据库路径(默认 data/job_butler.db)
JOB_BUTLER_DB=data/job_butler.db

# LLM(OpenAI 兼容协议;本地 vLLM 或任一云厂商)
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen3-4b-awq
VLLM_API_KEY=EMPTY

# Embedding(OpenAI 兼容协议)
EMBED_BASE_URL=http://localhost:8001/v1
EMBED_API_KEY=EMPTY
